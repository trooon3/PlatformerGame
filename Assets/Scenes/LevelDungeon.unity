  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4ebec4f4a4463a4a9924bbf9727f325, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _russianText: "\u0426\u0435\u043B\u044C: \u041E\u0442\u043A\u0440\u044B\u0442\u044C
    \u0432\u043E\u0440\u043E\u0442\u0430 \u043D\u0430 \u043D\u0438\u0436\u043D\u0435\u043C
    \u0443\u0440\u043E\u0432\u043D\u0435 \u0442\u044E\u0440\u044C\u043C\u044B, \u0434\u043B\u044F
    \u044D\u0442\u043E\u0433\u043E \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C
    \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u0431\u043E\u0441\u0441\u043E\u0432,
    \u043A \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0438\u0437 \u043D\u0438\u0445
    \u0432\u0435\u0434\u0451\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0430
    \u0434\u0432\u0435\u0440\u044C \u0438 \u043E\u0434\u0438\u043D \u043A\u043B\u044E\u0447"
  _englishText: 'Objective: Open the gates on the lower level of the prison; to do
    so, you must defeat four bosses, each accessible via a single door requiring
    a specific key.'
  _turkishText: "Ama\xE7: Hapishanenin alt kat\u0131ndaki kap\u0131lar\u0131 a\xE7mak;
    bunu yapmak i\xE7in, her birine belirli bir anahtar gerektiren tek bir kap\u0131dan
    ula\u015F\u0131lan d\xF6rt b\xF6l\xFCm sonu canavar\u0131n\u0131 yenmelisiniz.\r\n"
